{
  "name": "Ride Replay",
  "short_name": "Ride Replay",
  "description": "Replay your bike rides on a 3D satellite map.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12171a",
  "theme_color": "#12171a",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {"name": "gpx", "accept": [".gpx", "application/gpx+xml", "application/gpx", "application/xml", "text/xml", "application/octet-stream", "text/plain"]}
      ]
    }
  }
}
